# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Server only. Never prefix with NEXT_PUBLIC_. Needed for the GitHub integration (stage 4).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# LiveKit (cloud.livekit.io -> Project -> Settings -> Keys)
NEXT_PUBLIC_LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR-API-KEY
LIVEKIT_API_SECRET=YOUR-API-SECRET

# GitHub repo integration (owner only). Create an OAuth App at github.com/settings/developers
# Callback URL: <your site>/api/github/callback
GITHUB_CLIENT_ID=YOUR-GITHUB-OAUTH-CLIENT-ID
GITHUB_CLIENT_SECRET=YOUR-GITHUB-OAUTH-CLIENT-SECRET
# 32 random bytes, base64:  openssl rand -base64 32
GITHUB_TOKEN_ENC_KEY=YOUR-BASE64-32-BYTE-KEY
# Public origin used for the OAuth redirect (optional locally)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
